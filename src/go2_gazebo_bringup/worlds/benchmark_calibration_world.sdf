          <geometry><box><size>0.50 2.50 0.005</size></box></geometry>
          <material><ambient>0.95 0.85 0.10 1</ambient><diffuse>0.95 0.85 0.10 1</diffuse></material>
        </visual>

        <!-- ========== Path B Accessible Gentle Bridge (x = 0.0, y = -10.4m, width = 2.4m) ========== -->
        <!-- Gentle 10° Bridge (run = 1.8m, pitch = -0.1745 rad, rise = 0.32m) -->
        <collision name='s4_bridge_up'>
