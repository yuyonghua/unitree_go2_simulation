    <!-- ========================================================================= -->
    <!-- 5. TRACK 4: Scenario S4 — Bifurcated Route Selection Stress Test           -->
    <!-- Center y = -8.5m, X in [-7.5, 8.5]                                         -->
    <!-- Path A (North, Short direct 12.5m): Blocked at x = 0.0 by 18cm lethal step  -->
    <!-- Path B (South, Detour 18.5m, +48% long): Gentle 10° accessible bridge      -->
    <!-- ========================================================================= -->
    <model name='lane_s4_bifurcated_route'>
      <static>true</static>
      <link name='s4_elements'>
        <!-- Central Island Wall separating Path A (North) and Path B (South) -->
        <!-- Center y = -8.5m, X in [-3.5, 4.0], thickness = 1.0m (y in [-9.0, -8.0]) -->
        <collision name='s4_center_island'>
