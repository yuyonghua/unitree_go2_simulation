        </visual>

        <!-- ========== Path A Lethal Trap (x = 0.0, y = -6.5m, width = 2.6m) ========== -->
        <!-- 18cm Rigid Step Barrier spanning entire width of Path A (No bypass!) -->
        <collision name='s4_path_a_trap'>
