<?xml version='1.0' encoding='ASCII'?>
<sdf version='1.7'>
  <world name='inspection_obstacle_world'>
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Gazebo Harmonic Core System Plugins -->
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics">
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu">
    </plugin>

    <!-- Global Sunlight -->
    <light type='directional' name='sun'>
      <cast_shadows>true</cast_shadows>
      <pose>5 0 25 0 0 0</pose>
      <diffuse>0.92 0.92 0.92 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.35 0.25 -0.9</direction>
    </light>

    <!-- Secondary Skylight Fill Illumination -->
    <light type='directional' name='skylight_fill'>
      <cast_shadows>false</cast_shadows>
      <pose>-5 5 20 0 0 0</pose>
      <diffuse>0.40 0.42 0.45 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>0.3 -0.2 -0.8</direction>
    </light>

    <!-- High Friction Ground Plane (ASTM Standard Traction, mu=1.5) -->
    <model name='ground_plane'>
      <static>true</static>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>70 70</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.5</mu>
                <mu2>1.5</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name='visual'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>70 70</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.35 0.37 0.39 1</ambient>
            <diffuse>0.35 0.37 0.39 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>8 0 0 0 0 0</pose>
    </model>

    <!-- ========================================================================= -->
    <!-- 1. Arena Boundary & Dividing Enclosure (36m x 24m)                        -->
    <!-- ========================================================================= -->
    <model name='arena_enclosure'>
      <static>true</static>
      <link name='walls'>
        <!-- South Perimeter Wall (y = -12.0) -->
        <collision name='wall_south'>
          <pose>8 -12 1.5 0 0 0</pose>
          <geometry><box><size>36 0.3 3.0</size></box></geometry>
        </collision>
        <visual name='wall_south_vis'>
          <pose>8 -12 1.5 0 0 0</pose>
          <geometry><box><size>36 0.3 3.0</size></box></geometry>
          <material><ambient>0.52 0.55 0.58 1</ambient><diffuse>0.52 0.55 0.58 1</diffuse></material>
        </visual>

        <!-- North Perimeter Wall (y = +12.0) -->
        <collision name='wall_north'>
          <pose>8 12 1.5 0 0 0</pose>
          <geometry><box><size>36 0.3 3.0</size></box></geometry>
        </collision>
        <visual name='wall_north_vis'>
          <pose>8 12 1.5 0 0 0</pose>
          <geometry><box><size>36 0.3 3.0</size></box></geometry>
          <material><ambient>0.52 0.55 0.58 1</ambient><diffuse>0.52 0.55 0.58 1</diffuse></material>
        </visual>

        <!-- West Perimeter Wall (x = -10.0) -->
        <collision name='wall_west'>
          <pose>-10 0 1.5 0 0 0</pose>
          <geometry><box><size>0.3 24 3.0</size></box></geometry>
        </collision>
        <visual name='wall_west_vis'>
          <pose>-10 0 1.5 0 0 0</pose>
          <geometry><box><size>0.3 24 3.0</size></box></geometry>
          <material><ambient>0.52 0.55 0.58 1</ambient><diffuse>0.52 0.55 0.58 1</diffuse></material>
        </visual>

        <!-- East Perimeter Wall (x = +26.0) -->
        <collision name='wall_east'>
          <pose>26 0 1.5 0 0 0</pose>
          <geometry><box><size>0.3 24 3.0</size></box></geometry>
        </collision>
        <visual name='wall_east_vis'>
          <pose>26 0 1.5 0 0 0</pose>
          <geometry><box><size>0.3 24 3.0</size></box></geometry>
          <material><ambient>0.52 0.55 0.58 1</ambient><diffuse>0.52 0.55 0.58 1</diffuse></material>
        </visual>

        <!-- Zone A & Zone B Partition Wall (y = -2.0) with central courtyard gateway -->
        <collision name='part_wall_w'>
          <pose>-1.0 -2.0 0.9 0 0 0</pose>
          <geometry><box><size>4.0 0.25 1.8</size></box></geometry>
        </collision>
        <visual name='part_wall_w_vis'>
          <pose>-1.0 -2.0 0.9 0 0 0</pose>
          <geometry><box><size>4.0 0.25 1.8</size></box></geometry>
          <material><ambient>0.38 0.42 0.46 1</ambient><diffuse>0.38 0.42 0.46 1</diffuse></material>
        </visual>

        <collision name='part_wall_e'>
          <pose>16.5 -2.0 0.9 0 0 0</pose>
          <geometry><box><size>17.0 0.25 1.8</size></box></geometry>
        </collision>
        <visual name='part_wall_e_vis'>
          <pose>16.5 -2.0 0.9 0 0 0</pose>
          <geometry><box><size>17.0 0.25 1.8</size></box></geometry>
          <material><ambient>0.38 0.42 0.46 1</ambient><diffuse>0.38 0.42 0.46 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ========================================================================= -->
    <!-- 2. Zone A: 校园综合实验教学楼首层大厅与自习连廊 (1F Campus Complex)          -->
    <!-- 机器狗生成点 (0, 0, 0.45) 处于开阔开门迎宾广场，周边 2.5m 绝对空旷无阻挡      -->
    <!-- ========================================================================= -->

    <!-- 1F 西侧自习与学术交流休闲区 (x in [-8, -3.5], y in [0.5, 11]) -->
    <include>
      <uri>model://aws_robomaker_residential_ReadingDesk_01</uri>
      <name>campus_reading_desk_1</name>
      <pose>-5.5 1.5 0 0 0 0</pose>
      <static>true</static>
    </include>

    <include>
      <uri>model://aws_robomaker_residential_ChairD_01</uri>
      <name>campus_chair_1</name>
      <pose>-5.5 2.2 0 0 0 3.1416</pose>
      <static>true</static>
    </include>

    <include>
      <uri>model://cafe_table</uri>
      <name>campus_cafe_table_1</name>
      <pose>-5.5 5.5 0 0 0 0</pose>
      <static>true</static>
    </include>

    <include>
      <uri>model://aws_robomaker_residential_ChairD_01</uri>
      <name>campus_chair_2</name>
      <pose>-5.5 6.4 0 0 0 3.1416</pose>
      <static>true</static>
    </include>

    <include>
      <uri>model://aws_robomaker_warehouse_TrashCanC_01</uri>
      <name>campus_trash_can_1</name>
      <pose>-7.0 0.8 0 0 0 0</pose>
      <static>true</static>
    </include>

    <include>
      <uri>model://cardboard_box</uri>
      <name>campus_delivery_box_1</name>
      <pose>-6.8 5.2 0.15 0 0 0.2</pose>
      <static>true</static>
    </include>

    <include>
      <uri>model://cardboard_box</uri>
      <name>campus_delivery_box_2</name>
      <pose>-6.8 5.7 0.15 0 0 -0.1</pose>
      <static>true</static>
    </include>

    <!-- 1F 西侧自习室隔离墙 (形成 1.2m 门洞过道) -->
    <model name='campus_1f_lounge_walls'>
      <static>true</static>
      <link name='lounge_wall_link'>
        <collision name='lounge_wall_s'>
          <pose>-5.5 -0.1 0.9 0 0 0</pose>
          <geometry><box><size>4.5 0.2 1.8</size></box></geometry>
        </collision>
        <visual name='lounge_wall_s_v'>
          <pose>-5.5 -0.1 0.9 0 0 0</pose>
          <geometry><box><size>4.5 0.2 1.8</size></box></geometry>
          <material><ambient>0.6 0.62 0.65 1</ambient><diffuse>0.6 0.62 0.65 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ========================================================================= -->
    <!-- 3. 3D 悬空净空管道对比组 (Overhang Clearance, 证明 3D 相比 2D 的优势)         -->
    <!-- ========================================================================= -->
    <model name='overhang_clearance_test'>
      <static>true</static>
      <link name='overhang_pipes'>
        <!-- [1] 低空致死悬空横管 (净空 = 0.35m < 机体高 0.40m -> 头部致命碰撞, Lethal 254) -->
        <collision name='pipe_low_post_l'>
          <pose>1.8 4.5 0.35 0 0 0</pose>
          <geometry><cylinder><radius>0.05</radius><length>0.7</length></cylinder></geometry>
        </collision>
        <visual name='pipe_low_post_l_v'>
          <pose>1.8 4.5 0.35 0 0 0</pose>
          <geometry><cylinder><radius>0.05</radius><length>0.7</length></cylinder></geometry>
          <material><ambient>0.85 0.2 0.1 1</ambient><diffuse>0.85 0.2 0.1 1</diffuse></material>
        </visual>

        <collision name='pipe_low_post_r'>
          <pose>1.8 7.5 0.35 0 0 0</pose>
          <geometry><cylinder><radius>0.05</radius><length>0.7</length></cylinder></geometry>
        </collision>
        <visual name='pipe_low_post_r_v'>
          <pose>1.8 7.5 0.35 0 0 0</pose>
          <geometry><cylinder><radius>0.05</radius><length>0.7</length></cylinder></geometry>
          <material><ambient>0.85 0.2 0.1 1</ambient><diffuse>0.85 0.2 0.1 1</diffuse></material>
        </visual>

        <!-- 管道中心标高 0.425m, 半径 0.075m -> 底部净空 0.35m -->
        <collision name='pipe_low_bar'>
          <pose>1.8 6.0 0.425 1.5708 0 0</pose>
          <geometry><cylinder><radius>0.075</radius><length>3.2</length></cylinder></geometry>
        </collision>
        <visual name='pipe_low_bar_v'>
          <pose>1.8 6.0 0.425 1.5708 0 0</pose>
          <geometry><cylinder><radius>0.075</radius><length>3.2</length></cylinder></geometry>
          <material><ambient>0.95 0.25 0.15 1</ambient><diffuse>0.95 0.25 0.15 1</diffuse></material>
        </visual>

        <!-- [2] 高空通行建筑管线 (净空 = 0.85m > 机体高 0.40m -> 四足安全穿行, 2D代价地图误报死墙) -->
        <collision name='pipe_high_post_l'>
          <pose>3.8 4.5 0.65 0 0 0</pose>
          <geometry><cylinder><radius>0.06</radius><length>1.3</length></cylinder></geometry>
        </collision>
        <visual name='pipe_high_post_l_v'>
          <pose>3.8 4.5 0.65 0 0 0</pose>
          <geometry><cylinder><radius>0.06</radius><length>1.3</length></cylinder></geometry>
          <material><ambient>0.4 0.45 0.5 1</ambient><diffuse>0.4 0.45 0.5 1</diffuse></material>
        </visual>

        <collision name='pipe_high_post_r'>
          <pose>3.8 7.5 0.65 0 0 0</pose>
          <geometry><cylinder><radius>0.06</radius><length>1.3</length></cylinder></geometry>
        </collision>
        <visual name='pipe_high_post_r_v'>
          <pose>3.8 7.5 0.65 0 0 0</pose>
          <geometry><cylinder><radius>0.06</radius><length>1.3</length></cylinder></geometry>
          <material><ambient>0.4 0.45 0.5 1</ambient><diffuse>0.4 0.45 0.5 1</diffuse></material>
        </visual>

        <!-- 管道中心标高 0.95m, 半径 0.10m -> 底部净空 0.85m -->
        <collision name='pipe_high_bar'>
          <pose>3.8 6.0 0.95 1.5708 0 0</pose>
          <geometry><cylinder><radius>0.10</radius><length>3.2</length></cylinder></geometry>
        </collision>
        <visual name='pipe_high_bar_v'>
          <pose>3.8 6.0 0.95 1.5708 0 0</pose>
          <geometry><cylinder><radius>0.10</radius><length>3.2</length></cylinder></geometry>
          <material><ambient>0.75 0.78 0.82 1</ambient><diffuse>0.75 0.78 0.82 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ========================================================================= -->
    <!-- 4. 1F 真实架空景观台地与负向地坑边缘 (Negative Drop-Off Trench)               -->
    <!-- 机器狗走上 +0.35m 架空台地，直面 0.35m 真实跌落悬崖与侧向保底廊桥              -->
    <!-- ========================================================================= -->
    <model name='campus_raised_terrace_with_pit'>
      <static>true</static>
      <link name='terrace_link'>
        <!-- 上台阶 1: 标高 +0.175m (x = 3.65) -->
        <collision name='step_up_1'>
          <pose>3.65 1.0 0.0875 0 0 0</pose>
          <geometry><box><size>0.35 4.8 0.175</size></box></geometry>
          <surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction></surface>
        </collision>
        <visual name='step_up_1_v'>
          <pose>3.65 1.0 0.0875 0 0 0</pose>
          <geometry><box><size>0.35 4.8 0.175</size></box></geometry>
          <material><ambient>0.85 0.65 0.15 1</ambient><diffuse>0.85 0.65 0.15 1</diffuse></material>
        </visual>

        <!-- 西段架空台地 (x in [3.85, 6.20], y in [-1.4, 3.4], 顶面标高 z = +0.35m) -->
        <collision name='terrace_west_deck'>
          <pose>5.025 1.0 0.175 0 0 0</pose>
          <geometry><box><size>2.35 4.8 0.35</size></box></geometry>
          <surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction></surface>
        </collision>
        <visual name='terrace_west_deck_v'>
          <pose>5.025 1.0 0.175 0 0 0</pose>
          <geometry><box><size>2.35 4.8 0.35</size></box></geometry>
          <material><ambient>0.42 0.45 0.48 1</ambient><diffuse>0.42 0.45 0.48 1</diffuse></material>
        </visual>

        <!-- 负向地坑边缘警示线 (西侧悬崖边缘 x = 6.20) -->
        <visual name='pit_warning_edge_w'>
          <pose>6.15 0.1 0.355 0 0 0</pose>
          <geometry><box><size>0.10 3.0 0.01</size></box></geometry>
          <material><ambient>0.95 0.25 0.1 1</ambient><diffuse>0.95 0.25 0.1 1</diffuse></material>
        </visual>

        <!-- 【核心负向障碍】中间开敞跌落地坑 (x in [6.20, 7.80], y in [-1.4, 1.6]) -->
        <!-- 该区域完全无顶板，直接垂直跌落 0.35m 摔到地面 z=0！3D可通行度检测到高程突变必须判定致死拒行 -->

        <!-- 侧向保底窄廊桥 (x in [6.20, 7.80], y in [1.6, 3.4], 宽 1.8m，顶面标高 z = +0.35m) -->
        <collision name='bypass_bridge_deck'>
          <pose>7.0 2.5 0.175 0 0 0</pose>
          <geometry><box><size>1.6 1.8 0.35</size></box></geometry>
          <surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction></surface>
        </collision>
        <visual name='bypass_bridge_deck_v'>
          <pose>7.0 2.5 0.175 0 0 0</pose>
          <geometry><box><size>1.6 1.8 0.35</size></box></geometry>
          <material><ambient>0.32 0.65 0.40 1</ambient><diffuse>0.32 0.65 0.40 1</diffuse></material>
        </visual>

        <!-- 廊桥临空防跌落护栏 (y = 1.60) -->
        <collision name='bridge_guardrail'>
          <pose>7.0 1.62 0.55 0 0 0</pose>
          <geometry><box><size>1.6 0.05 0.40</size></box></geometry>
        </collision>
        <visual name='bridge_guardrail_v'>
          <pose>7.0 1.62 0.55 0 0 0</pose>
          <geometry><box><size>1.6 0.05 0.40</size></box></geometry>
          <material><ambient>0.85 0.65 0.1 1</ambient><diffuse>0.85 0.65 0.1 1</diffuse></material>
        </visual>

        <!-- 东段架空台地 (x in [7.80, 10.20], y in [-1.4, 3.4], 顶面标高 z = +0.35m) -->
        <collision name='terrace_east_deck'>
          <pose>9.0 1.0 0.175 0 0 0</pose>
          <geometry><box><size>2.4 4.8 0.35</size></box></geometry>
          <surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction></surface>
        </collision>
        <visual name='terrace_east_deck_v'>
          <pose>9.0 1.0 0.175 0 0 0</pose>
          <geometry><box><size>2.4 4.8 0.35</size></box></geometry>
          <material><ambient>0.42 0.45 0.48 1</ambient><diffuse>0.42 0.45 0.48 1</diffuse></material>
        </visual>

        <!-- 下台阶: 回到地面标高 z=0 (x = 10.35) -->
        <collision name='step_down_1'>
          <pose>10.35 1.0 0.0875 0 0 0</pose>
          <geometry><box><size>0.35 4.8 0.175</size></box></geometry>
          <surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction></surface>
        </collision>
        <visual name='step_down_1_v'>
          <pose>10.35 1.0 0.0875 0 0 0</pose>
          <geometry><box><size>0.35 4.8 0.175</size></box></geometry>
          <material><ambient>0.85 0.65 0.15 1</ambient><diffuse>0.85 0.65 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ========================================================================= -->
    <!-- 5. 双垂直通道之【通道一】：东侧 ASTM E2804 规范双跑折返楼梯 (Dog-Leg Stair) -->
    <!-- 垂直攀爬标高升至 +2.4m 二层平台 (Flight 1 -> 休息平台 -> Flight 2)        -->
    <!-- ========================================================================= -->
    <model name='east_dogleg_staircase'>
      <static>true</static>
      <link name='staircase_structure'>
        <!-- 第一梯跑 Flight 1: 10 阶向东上升至 +1.20m (y in [4.20, 5.50]) -->
        <collision name='f1_step_1'><pose>11.14 4.85 0.06 0 0 0</pose><geometry><box><size>0.28 1.30 0.12</size></box></geometry><surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction></surface></collision>
        <visual name='f1_step_1_v'><pose>11.14 4.85 0.06 0 0 0</pose><geometry><box><size>0.28 1.30 0.12</size></box></geometry><material><ambient>0.85 0.65 0.15 1</ambient><diffuse>0.85 0.65 0.15 1</diffuse></material></visual>

        <collision name='f1_step_2'><pose>11.42 4.85 0.12 0 0 0</pose><geometry><box><size>0.28 1.30 0.24</size></box></geometry><surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction></surface></collision>
        <visual name='f1_step_2_v'><pose>11.42 4.85 0.12 0 0 0</pose><geometry><box><size>0.28 1.30 0.24</size></box></geometry><material><ambient>0.85 0.65 0.15 1</ambient><diffuse>0.85 0.65 0.15 1</diffuse></material></visual>

        <collision name='f1_step_3'><pose>11.70 4.85 0.18 0 0 0</pose><geometry><box><size>0.28 1.30 0.36</size></box></geometry><surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction></surface></collision>
        <visual name='f1_step_3_v'><pose>11.70 4.85 0.18 0 0 0</pose><geometry><box><size>0.28 1.30 0.36</size></box></geometry><material><ambient>0.85 0.65 0.15 1</ambient><diffuse>0.85 0.65 0.15 1</diffuse></material></visual>

        <collision name='f1_step_4'><pose>11.98 4.85 0.24 0 0 0</pose><geometry><box><size>0.28 1.30 0.48</size></box></geometry><surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction></surface></collision>
        <visual name='f1_step_4_v'><pose>11.98 4.85 0.24 0 0 0</pose><geometry><box><size>0.28 1.30 0.48</size></box></geometry><material><ambient>0.85 0.65 0.15 1</ambient><diffuse>0.85 0.65 0.15 1</diffuse></material></visual>

        <collision name='f1_step_5'><pose>12.26 4.85 0.30 0 0 0</pose><geometry><box><size>0.28 1.30 0.60</size></box></geometry><surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction></surface></collision>
        <visual name='f1_step_5_v'><pose>12.26 4.85 0.30 0 0 0</pose><geometry><box><size>0.28 1.30 0.60</size></box></geometry><material><ambient>0.85 0.65 0.15 1</ambient><diffuse>0.85 0.65 0.15 1</diffuse></material></visual>

        <collision name='f1_step_6'><pose>12.54 4.85 0.36 0 0 0</pose><geometry><box><size>0.28 1.30 0.72</size></box></geometry><surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction></surface></collision>
        <visual name='f1_step_6_v'><pose>12.54 4.85 0.36 0 0 0</pose><geometry><box><size>0.28 1.30 0.72</size></box></geometry><material><ambient>0.85 0.65 0.15 1</ambient><diffuse>0.85 0.65 0.15 1</diffuse></material></visual>

        <collision name='f1_step_7'><pose>12.82 4.85 0.42 0 0 0</pose><geometry><box><size>0.28 1.30 0.84</size></box></geometry><surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction></surface></collision>
