    <!-- ========================================================================= -->
    <!-- 8. Zone B: 侧翼 ASTM E54.09 标准标定消融测试道 (Calibration Lane)            -->
    <!-- y in [-11.5, -2.5], 标称测试中心线 y = -7.0, 跑道宽度 3.2m                   -->
    <!-- 保障严密单一变量消融对比 (E2804 阶梯梯度、E2803 连续坡道与 E2828 碎石阵列)    -->
