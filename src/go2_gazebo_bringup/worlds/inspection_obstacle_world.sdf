    <!-- ========================================================================= -->
    <!-- 6. 双垂直通道之【通道二】：西侧校园无障碍连续大跨度坡道 (Accessible Ramp)   -->
    <!-- 从地面 x=3.5 平缓爬升至二层 x=-4.5 (坡长 8.35m, 跨度 8m, 标高 0 -> 2.40m)   -->
    <!-- 形成楼梯 vs 坡道双闭环回路，支持拓扑自愈重寻路与通行代价选线验证              -->
    <!-- ========================================================================= -->
    <model name='west_accessible_ramp'>
      <static>true</static>
      <link name='ramp_link'>
        <!-- 坡道甲板 (斜率约 16.7°, pitch = +0.2915 rad, 长 8.35m, 宽 1.4m) -->
        <collision name='ramp_deck'>
          <pose>-0.5 4.8 1.20 0 0.2915 0</pose>
          <geometry><box><size>8.35 1.40 0.10</size></box></geometry>
          <surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction></surface>
        </collision>
        <visual name='ramp_deck_v'>
          <pose>-0.5 4.8 1.20 0 0.2915 0</pose>
          <geometry><box><size>8.35 1.40 0.10</size></box></geometry>
          <material><ambient>0.35 0.55 0.45 1</ambient><diffuse>0.35 0.55 0.45 1</diffuse></material>
        </visual>

        <!-- 坡道南侧安全护栏 -->
        <collision name='ramp_rail_s'>
          <pose>-0.5 4.12 1.65 0 0.2915 0</pose>
          <geometry><box><size>8.35 0.05 0.80</size></box></geometry>
        </collision>
        <visual name='ramp_rail_s_v'>
          <pose>-0.5 4.12 1.65 0 0.2915 0</pose>
          <geometry><box><size>8.35 0.05 0.80</size></box></geometry>
          <material><ambient>0.85 0.65 0.1 1</ambient><diffuse>0.85 0.65 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

