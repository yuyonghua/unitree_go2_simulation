  <version>0.0.0</version>
  <description>Gazebo Fortress simulation bringup and world environments for Unitree Go2</description>
  <maintainer email="yyhstd@qq.com">Unitree GO2 Project</maintainer>
  <author email="yanyuze@foxmail.com">yanyuze1</author>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>pointcloud_to_laserscan</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>go2_description</exec_depend>
  <exec_depend>quadropted_controller</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>xacro</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
