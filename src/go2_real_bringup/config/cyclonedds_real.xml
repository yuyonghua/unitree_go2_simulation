<?xml version="1.0" encoding="UTF-8" ?>
<CycloneDDS>
  <Domain Id="any">
    <General>
      <Interfaces>
        <!-- 支持通过环境变量 GO2_IFACE 动态覆盖网卡名称 (例如 export GO2_IFACE=eth0)；
             未设置时默认回退至 enx6c1ff75fac3f，确保现有环境 100% 向后兼容 -->
        <NetworkInterface name="${GO2_IFACE:-enx6c1ff75fac3f}" priority="default" multicast="default" />
        <!-- 兜底：USB 网卡抖动/掉线时，本地节点仍可经 lo 互相发现，
             避免整个 DDS 域僵死（RViz 未响应、关不掉、只能 SIGKILL）。
             注意：lo 通不了狗，掉网卡后狗数据还是会断，但本地栈可调试、可正常退出 -->
        <NetworkInterface name="lo" priority="default" multicast="true" />
      </Interfaces>
    </General>
  </Domain>
</CycloneDDS>
